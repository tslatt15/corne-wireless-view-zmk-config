#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <190>; };

&mt { tapping-term-ms = <190>; };

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        tp_dc_tog_base: tp_dc_tog_base {
            compatible = "zmk,behavior-tap-dance";
            label = "TP_DC_TOG_BASE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 0>;

            tapping-term-ms = <180>;
        };

        tp_dc_cole: tp_dc_cole {
            compatible = "zmk,behavior-tap-dance";
            label = "TP_DC_COLE";
            #binding-cells = <0>;
            bindings = <&mo 3>, <&tog 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_qwerty {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ALT  |
            //                    | GUI | NUM | SPC |   | ENT | SYM  | MDA |

            display-name = "qwerty";
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E         &kp R            &kp T          &kp Y      &kp U        &kp I           &kp O    &kp P     &kp BSPC
&kp LCTRL   &kp A  &kp S  &kp D         &kp F            &kp G          &kp H      &kp J        &kp K           &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X  &kp C         &kp V            &kp B          &kp N      &kp M        &kp COMMA       &kp DOT  &kp FSLH  &kp RIGHT_ALT
                          &mt LGUI TAB  &tp_dc_tog_base  &lt 5 SPACE    &lt 4 RET  &tp_dc_cole  &lt 6 CAPSLOCK
            >;
        };

        Colemak-DH_Layer {
   // -----------------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  ;  | BKSP |
            // | CTRL |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  |  '   |
            // | SHFT |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | ALT  |
            //                    | GUI | NUM | SPC |   | ENT | SYM  | MDA |
            display-name = "colemak-dh";
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp F         &kp P            &kp B          &kp J      &kp L        &kp U           &kp Y    &kp SEMI  &kp BSPC
&kp LCTRL   &kp A  &kp R  &kp S         &kp T            &kp G          &kp M      &kp N        &kp E           &kp I    &kp O     &kp APOS
&kp LSHFT   &kp Z  &kp X  &kp C         &kp D            &kp V          &kp K      &kp H        &kp COMMA       &kp DOT  &kp FSLH  &kp RIGHT_ALT
                          &mt LGUI TAB  &tp_dc_tog_base  &lt 5 SPACE    &lt 4 RET  &tp_dc_cole  &lt 6 CAPSLOCK
            >;
        };

        NumNav_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CTRL | HOME| END | INS | DEL | PGUP|   |     |     |     |     |     |      |
            // | SHFT | UNDO| CUT | CPY | PST | PGDN|   |     |     |     |     |     |      |
            //                    | GUI | NUM | SPC |   | ENT | SYM  | MDA |

            display-name = "Num";
            bindings = <
&trans  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5           &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
&trans  &kp HOME   &kp END    &kp INS    &kp DEL    &kp PAGE_UP      &none   &none   &none   &none   &none   &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp PAGE_DOWN    &none   &none   &none   &trans  &none   &none
                              &trans     &trans     &trans           &trans  &trans  &trans
            >;
        };

        Symbol_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |  <  |  >  |     |   |  -  |  =  |  [  |  ]  | "|" |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  \  |  ~   |
            //                    | GUI | NUM | SPC |   | ENT | SYM  | MDA |

            display-name = "Symbol";
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH       &kp DLLR          &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR       &kp BSPC
&trans  &none     &none   &kp LESS_THAN  &kp GREATER_THAN  &none        &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp PIPE       &kp GRAVE
&trans  &none     &none   &none          &none             &none        &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp BACKSLASH  &kp TILDE
                          &trans         &trans            &trans       &trans     &trans     &trans
            >;
        };

        Func_Nav_Layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |    |  F1  |  F2  | F3  | F10 |   |     |      |  UP  |       |     | BKSP |
            // | CTRL |    |  F4  |  F5  | F6  | F11 |   |     | LEFT | DOWN | RIGHT |     |      |
            // | SHFT |    |  F7  |  F8  | F9  | F12 |   |     |      |      |       |     |  ALT |
            //                    | GUI  | NUM | SPC |   | ENT | SYM  | MDA  |
            display-name = "Fun/Nav";
            bindings = <
&trans  &none  &kp F1  &kp F2  &kp F3  &kp F10    &none   &none           &kp UP_ARROW    &none      &none  &kp BACKSPACE
&trans  &none  &kp F4  &kp F5  &kp F6  &kp F11    &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none  &none
&trans  &none  &kp F7  &kp F8  &kp F9  &kp F12    &none   &none           &none           &none      &none  &kp RALT
                       &trans  &trans  &trans     &trans  &trans          &trans
            >;
        };

        Mouse_Layer {
            // -----------------------------------------------------------------------------------------
            // |    |    |      | M_UP |      |     |   |     |       | SC_UP |       |     |      |
            // |    |    | M_LF | M_DN | M_RI |     |   |     | SC_LF | SC_DN | SC_RI |     |      |
            // |    |    | UNDO | CUT  | CPY  | PST |   |     |       |       |       |     |      |
            //                  |      |      |     |         | LCLK  | RCLK  | MCLK  |
            bindings = <
&none  &none      &none           &mmv MOVE_UP    &none            &none     &none      &none           &msc SCRL_UP    &none            &none  &none
&none  &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none  &none
&none  &kp LC(Z)  &kp LC(X)       &kp LC(C)       &kp LC(V)        &none     &none      &none           &none           &none            &none  &none
                                  &trans          &trans           &trans    &mkp LCLK  &mkp RCLK       &mkp MCLK
            >;

            label = "Mouse";
        };

        Media {
            // -----------------------------------------------------------------------------------------
            // |      |     |     |     |     |      |   |     |       | SC_UP |       |      |      |
            // |BT_CLR| BT0 | BT1 | BT2 | BT3 | BT4  |   |     | PAUSE | VOL_UP| VOL_DN| MUTE |      |
            // |      |     |     |     |     |      |   |     |       |       |       |      |      |
            //                    | GUI  | NUM | SPC |   | ENT |  SYM  |  MDA  |
            display-name = "Media";
            bindings = <
&none       &none         &none         &none         &none         &bootloader     &none             &none            &none              &none       &none  &kp LS(LA(DEL))
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE  &none  &none
&none       &none         &none         &none         &none         &none           &none             &none            &none              &none       &none  &none
                                        &trans        &trans        &trans          &trans            &trans           &trans
            >;
        };
    };
};
